# ==========================================
# Fuga, SA — Environment Variables
# ==========================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# Get these from: Supabase Dashboard → Settings → API
# ==========================================

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG.......YOUR_ANON_KEY

# For admin panel (Dashboard → Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=eyJhbG.......YOUR_SERVICE_ROLE_KEY

# Admin password for /admin page
ADMIN_PASSWORD=your-secure-password
